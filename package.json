{
  "name": "@arkecosystem/missed-blocks-plugin",
  "version": "1.0.1",
  "description": "ARK Core plugin that dispatches a `block.missed` event whenever a delegate misses its slot in a round",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArkEcosystem/core-missed-blocks.git"
  },
  "bugs": {
    "url": "https://github.com/ArkEcosystem/core-missed-blocks/issues"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index",
  "types": "dist/index",
  "scripts": {
    "build": "yarn clean && yarn compile",
    "build:watch": "yarn clean && yarn compile -w",
    "clean": "rimraf dist",
    "compile": "tsc",
    "prepublishOnly": "yarn build"
  },
  "dependencies": {
    "@arkecosystem/core-database": "^3.13.0",
    "@arkecosystem/core-kernel": "^3.13.0",
    "@arkecosystem/crypto": "^3.13.0",
    "joi": "17.12.1"
  },
  "devDependencies": {
    "rimraf": "^3.0.2",
    "typescript": "~4.9.5"
  },
  "engines": {
    "node": ">=16.x"
  },
  "arkecosystem": {
    "core": {
      "alias": "missed-blocks"
    }
  }
}
